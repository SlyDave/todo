{
  "name": "todo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=12"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/pro-solid-svg-icons": "^7.3.0",
    "@fortawesome/vue-fontawesome": "^3.3.1",
    "@iconify-json/lucide": "^1.2.117",
    "@iconify-json/simple-icons": "^1.2.90",
    "@nuxt/ui": "^4.10.0",
    "dompurify": "^3.2.6",
    "marked": "^16.1.1",
    "nuxt": "^4.5.1",
    "tailwindcss": "^4.3.2",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "vue-demi@0.14.10": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "minimatch": "^10.0.3",
    "brace-expansion": "^5.0.9",
    "glob": "^11.0.3",
    "readdir-glob": "^1.1.3"
  }
}
